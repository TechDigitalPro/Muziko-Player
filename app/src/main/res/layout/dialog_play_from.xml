<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:custom="http://schemas.android.com/apk/res-auto"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_margin="@dimen/dimen_20dp"
              android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_20dp"
        android:gravity="center_horizontal"
        android:text="@string/play_from"
        android:textColor="#505659"
        android:textSize="20sp"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/simpletooltip_overlay_circle_offset"
        android:gravity="center_horizontal"
        android:text="@string/desired_start_time"
        android:textColor="#858585"
        android:textSize="16sp"/>


    <com.whitebird.music.control.metrialRenge.RangeBar
        android:id="@+id/rangebar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_80dp"
        android:layout_margin="@dimen/simpletooltip_overlay_circle_offset"
        android:layout_marginLeft="@dimen/simpletooltip_overlay_circle_offset"
        android:layout_marginRight="@dimen/dimen_20dp"
        />

    <RelativeLayout
        android:id="@+id/buttonlayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/simpletooltip_overlay_circle_offset">
        <FrameLayout
            android:layout_width="75dp"
            android:layout_height="35dp"
            android:layout_centerInParent="true"
            android:layout_marginRight="5dp"
            android:layout_weight="1">

            <com.whitebird.music.widgets.PlayPauseButton
                android:id="@+id/playpause"
                android:layout_width="33dp"
                android:layout_height="33dp"
                android:padding="@dimen/dimen_20dp"
                android:layout_gravity="center" />


            <View
                android:id="@+id/playpausewrapper"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </FrameLayout>




    </RelativeLayout>

</LinearLayout>
