<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:elevation="5dp"
        android:theme="@style/ToolbarTheme"
        app:popupTheme="@style/ToolbarPopupTheme"/>

    <com.whitebird.music.widgets.FastScroller.views.FastScrollRecyclerView
        android:id="@+id/recyclerview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:fastScrollAutoHide="true"
        app:fastScrollAutoHideDelay="1500"
        android:layout_below="@+id/toolbar"
        app:fastScrollPopupBackgroundSize="56dp"
        app:fastScrollPopupBgColor="@color/colorAccent"
        app:fastScrollPopupPosition="adjacent"
        app:fastScrollPopupTextColor="@android:color/primary_text_dark"
        app:fastScrollPopupTextSize="36sp"
        app:fastScrollThumbEnabled="true"
        app:fastScrollThumbColor="@color/colorAccent"
        app:fastScrollEnableThumbInactiveColor="true"
        android:nestedScrollingEnabled="true"
        android:layout_above="@+id/btn_add"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"/>

    <include layout="@layout/empty_view"/>
    <TextView
        android:id="@+id/btn_add"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:textSize="20sp"
        android:textColor="@color/white"
        android:background="@color/colorPrimary"
        android:text="ADD"

        android:gravity="center"
        android:layout_alignParentBottom="true"/>


</RelativeLayout>