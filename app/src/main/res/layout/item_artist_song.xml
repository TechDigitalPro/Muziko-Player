<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:vumeter="http://schemas.android.com/tools"
    android:orientation="vertical"

    android:background="?attr/selectableItemBackground">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="5dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <ImageView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:id="@+id/albumArt"
            android:padding="1dp"
            android:layout_alignParentLeft="true"
            />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="15dp"
            android:paddingTop="5dp"
            android:layout_toRightOf="@+id/albumArt"
            android:layout_toLeftOf="@+id/visualizer"
            android:layout_marginRight="10dp">


            <TextView
                android:id="@+id/song_title"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:ellipsize="end"
                android:singleLine="true"
                style="@style/TextAppearance.AppCompat.Body1"/>

            <TextView
                android:id="@+id/song_album"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:paddingTop="3dp"
                android:textSize="12sp"
                android:ellipsize="end"
                android:singleLine="true"
                style="@style/TextAppearance.AppCompat.Widget.ActionMode.Subtitle"/>



        </LinearLayout>

       <!-- <net.steamcrafted.materialiconlib.MaterialIconView
            android:id="@+id/currentlyPlayingIndicator"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_marginRight="10dp"
            android:scaleType="center"
            app:materialIconColor="#fff"
            app:materialIconSize="35dp"
            android:visibility="invisible"
            android:layout_toLeftOf="@+id/popup_menu"/>-->
        <com.whitebird.music.widgets.VuMeterView
            android:id="@+id/visualizer"
            android:layout_width="25dp"
            android:layout_height="20dp"
            android:layout_centerVertical="true"
            android:layout_marginBottom="10dp"
            android:layout_marginRight="15dp"
            android:layout_toLeftOf="@+id/popup_menu"
            android:visibility="gone"
            vumeter:vumeter_backgroundColor="@color/normal_blue"
            vumeter:vumeter_blockNumber="3"
            vumeter:vumeter_blockSpacing="3dp"
            vumeter:vumeter_speed="15"
            vumeter:vumeter_startOff="false"
            vumeter:vumeter_stopSize="5dp"/>
        <com.whitebird.music.widgets.PopupImageView
            android:id="@+id/popup_menu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:foregroundTint="#434343"
            android:padding="5dp"
            android:src="@drawable/ic_drop_down_menu" />

    </RelativeLayout>

    <View
        android:id="@+id/viewOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="@color/colorPrimary">
    </View>

</FrameLayout>