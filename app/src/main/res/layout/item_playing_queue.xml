<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:vumeter="http://schemas.android.com/tools"
    android:background="?attr/selectableItemBackground"
    android:orientation="vertical"
    >

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:paddingBottom="6dp"
        android:paddingTop="6dp">

        <net.steamcrafted.materialiconlib.MaterialIconView
            android:id="@+id/reorder"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentLeft="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="center"
            app:materialIcon="drag_vertical"
            app:materialIconColor="?attr/iconColor"
            app:materialIconSize="30dp" />


        <ImageView
            android:id="@+id/albumArt"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_toRightOf="@+id/reorder"
            android:padding="1dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            android:layout_toLeftOf="@+id/visualizer"
            android:layout_toRightOf="@+id/albumArt"
            android:orientation="vertical"
            android:paddingLeft="10dp"
            android:paddingTop="5dp">


            <TextView
                android:id="@+id/song_title"
                style="@style/TextAppearance.AppCompat.Body1"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/song_artist"
                style="@style/TextAppearance.AppCompat.Widget.ActionMode.Subtitle"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:paddingTop="3dp"
                android:singleLine="true"
                android:textSize="13sp" />


        </LinearLayout>


        <com.whitebird.music.widgets.VuMeterView
            android:id="@+id/visualizer"
            android:layout_width="25dp"
            android:layout_height="20dp"
            android:layout_centerVertical="true"
            android:layout_marginBottom="10dp"
            android:layout_marginRight="15dp"
            android:layout_toLeftOf="@+id/popup_menu"
            android:visibility="gone" vumeter:vumeter_backgroundColor="@color/normal_blue"
            vumeter:vumeter_blockNumber="3"
            vumeter:vumeter_blockSpacing="3dp"
            vumeter:vumeter_speed="15"
            vumeter:vumeter_startOff="false"
            vumeter:vumeter_stopSize="5dp"/>


        <com.whitebird.music.widgets.PopupImageView
            android:id="@+id/popup_menu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:foregroundTint="#434343"
            android:padding="5dp"
            android:src="@drawable/ic_drop_down_menu" />





    </RelativeLayout>

    <View
        android:id="@+id/viewOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="@color/colorPrimary">
    </View>
</FrameLayout>